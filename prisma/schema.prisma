generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id       Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(100)
  categoria String @db.VarChar(100)
  pvp      Decimal @db.Decimal(10, 2)

  @@map("productos")
}
